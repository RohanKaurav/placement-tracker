datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prism-client-js"
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  college     String
  totalPoints Int      @default(0)
  solveCount  Int      @default(0)
  createdAt   DateTime @default(now())

  // Relations
  progress  UserProgress[]
  following Pin[]          @relation("Follower")
  followers Pin[]          @relation("Followed")
}

model Question {
  id         String @id @default(uuid())
  title      String
  url        String
  difficulty String // "EASY", "MEDIUM", "HARD"
  point      String //10, 20, 30

  //Relations
  userProgress UserProgress[]
}

model UserProgress {
  id         String    @id @default(uuid())
  userId     String
  questionId String
  isSolved   Boolean   @default(false)
  isStarred  Boolean   @default(false)
  notes      String?   @db.Text
  solvedAt   DateTime?
  updatedAt  DateTime  @updatedAt

  //Relations

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Pin {
  id         String   @id @default(uuid())
  followerId String
  followedId String
  createdAt  DateTime @default(now())

  // Relations
  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
}
